{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliveryPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policyName", "limits", "ci", "maintainabilityThresholds", "analysis", "classification", "checkCatalog", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "policyName": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxStagedFiles", "maxDiffSizeBytes", "maxSignals", "maxDiagnostics", "maxCheckLogBytes", "maxFailureSummaryLines"],
      "properties": {
        "maxStagedFiles": { "type": "integer", "minimum": 1 },
        "maxDiffSizeBytes": { "type": "integer", "minimum": 1 },
        "maxSignals": { "type": "integer", "minimum": 1 },
        "maxDiagnostics": { "type": "integer", "minimum": 1 },
        "maxCheckLogBytes": { "type": "integer", "minimum": 1024 },
        "maxFailureSummaryLines": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInFlightCommits"],
      "properties": {
        "maxInFlightCommits": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "maintainabilityThresholds": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyImpact", "cucumberImpact", "maintainability"],
      "properties": {
        "dependencyImpact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "adapter"],
          "properties": {
            "enabled": { "type": "boolean" },
            "adapter": { "type": "string", "minLength": 1 }
          }
        },
        "cucumberImpact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "adapter"],
          "properties": {
            "enabled": { "type": "boolean" },
            "adapter": { "type": "string", "minLength": 1 }
          }
        },
        "maintainability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "adapter"],
          "properties": {
            "enabled": { "type": "boolean" },
            "adapter": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "fallback"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "match", "isGateCTrigger", "isGate0Trigger", "productSource"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "exact": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "prefixes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "extensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "patterns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                }
              },
              "isGateCTrigger": { "type": "boolean" },
              "isGate0Trigger": { "type": "boolean" },
              "productSource": { "enum": [true, false, "auto"] }
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "isGateCTrigger", "isGate0Trigger", "productSource"],
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "isGateCTrigger": { "type": "boolean" },
            "isGate0Trigger": { "type": "boolean" },
            "productSource": { "enum": [true, false, "auto"] }
          }
        }
      }
    },
    "checkCatalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label", "command", "args", "display", "timeoutMs"],
            "properties": {
              "kind": { "const": "command" },
              "label": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "display": { "type": "string", "minLength": 1 },
              "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "timeoutMs": { "type": "integer", "minimum": 1000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label", "handler", "display"],
            "properties": {
              "kind": { "const": "builtin" },
              "label": { "type": "string", "minLength": 1 },
              "handler": { "type": "string", "minLength": 1 },
              "display": { "type": "string", "minLength": 1 },
              "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NONE", "0", "A", "B", "C", "D", "R"],
      "patternProperties": {
        "^(NONE|0|A|B|C|D|R)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "priority", "checkIds", "postPushChecks"],
          "properties": {
            "id": { "type": "string", "enum": ["NONE", "0", "A", "B", "C", "D", "R"] },
            "description": { "type": "string", "minLength": 1 },
            "priority": { "type": "integer", "minimum": 0 },
            "checkIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "postPushChecks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      }
    }
  }
}
