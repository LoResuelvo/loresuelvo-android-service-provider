{
  "$schema": "./schemas/policy.schema.json",
  "version": 1,
  "policyName": "loresuelvo-android-service-provider-delivery-policy",
  "limits": {
    "maxStagedFiles": 500,
    "maxDiffSizeBytes": 2097152,
    "maxSignals": 20,
    "maxDiagnostics": 20,
    "maxCheckLogBytes": 5242880,
    "maxFailureSummaryLines": 6
  },
  "ci": {
    "maxInFlightCommits": 4
  },
  "maintainabilityThresholds": {},
  "analysis": {
    "dependencyImpact": {
      "enabled": true,
      "adapter": "android-reviewed-ui-scope",
      "scopes": [
        {
          "featureFile": "app/src/test/resources/features/proposals/provider-service-proposal.feature",
          "sourceFile": "app/src/main/java/com/loresuelvo/serviceprovider/ui/screens/conversation/ProviderProposalConfirmationDialog.kt",
          "symbol": "ProviderProposalConfirmationDialog",
          "signature": "4723366b4c099cffffcc31a7e58aefcf93310c80ed1fbce64fa5cc105fd3d5b3",
          "vocabulary": "bacd9f53f47ebd4cc8be91d3aac005b573d641c73ad7d0e65ef34dec8ae17088",
          "consumers": [
            "app/src/main/java/com/loresuelvo/serviceprovider/ui/screens/conversation/ProviderConversationRoute.kt",
            "app/src/test/java/com/loresuelvo/serviceprovider/ui/screens/conversation/ProviderProposalScreenTest.kt"
          ],
          "boundarySymbols": [
            "MainActivity",
            "LoResuelvoNav",
            "ProviderConversationRoute"
          ],
          "testClasses": [
            "com.loresuelvo.serviceprovider.ui.screens.conversation.ProviderProposalScreenTest"
          ],
          "deviceTestClasses": [
            "com.loresuelvo.serviceprovider.acceptance.messaging.ProviderConversationAttachmentAcceptanceTest"
          ],
          "pinnedFiles": {
            "app/src/main/java/com/loresuelvo/serviceprovider/ui/screens/conversation/ProviderConversationRoute.kt": "a5f4f8f55908de734db0279dce87de5dab1aa80e5477979b1742adf3734c92c2",
            "app/src/test/java/com/loresuelvo/serviceprovider/ui/screens/conversation/ProviderProposalScreenTest.kt": "48005e9543ccca33aa5a0594746f771413eeba5de126cbc8cecde2cf40374b91",
            "app/src/main/java/com/loresuelvo/serviceprovider/MainActivity.kt": "72450febf02f62a815c955fd5ab4db269cdc94187b7c2d70953da15f4633dda9",
            "app/src/main/java/com/loresuelvo/serviceprovider/ui/navigation/LoResuelvoNav.kt": "52decde72134f0896939d7fa310462d6c64a066a263b5759587c0de2ade7f072",
            "app/src/main/java/com/loresuelvo/serviceprovider/ui/navigation/LoResuelvoNavHost.kt": "13d6eab9dc03b4600d5a2e910d2eb28e548ef8b1d8377714b0bc78435f81637f",
            "app/src/main/java/com/loresuelvo/serviceprovider/ui/theme/Theme.kt": "f4bd4d273c483df750b5fcc78b9787673a9b034c1da59c51b7d7c4c9881033a5",
            "app/src/main/AndroidManifest.xml": "a51bd26d477329e94b69e48ae1de87d8e211ad28470caec2d969b5600e7f2b97",
            "app/src/androidTest/java/com/loresuelvo/serviceprovider/acceptance/messaging/ProviderConversationAttachmentAcceptanceTest.kt": "d10294875d77b020f6b4489a176fff8e6318b1e54079daf569061e22554b10db",
            "app/src/test/java/com/loresuelvo/serviceprovider/bdd/proposals/ProviderProposalCucumberTest.kt": "ed608aae2d48eb33f28c5762a70c388981b8321fb7561d89556c74f230361439",
            "app/src/test/java/com/loresuelvo/serviceprovider/bdd/proposals/ProviderProposalSteps.kt": "a3a2101184b061ebbede48a5666029f6fbe68c9c888d48bd197f2f28dbb5f8fb",
            "app/build.gradle.kts": "886219b762b8b4691981c36321468b46f39bf455a8236e5042584b677635dfb4",
            "build.gradle.kts": "e915463b9250cfa529fec4407be0a76bf1fa9cab711ace9904f456c6b3474f0c",
            "settings.gradle.kts": "08cb3f5be0ff685cff9305d4161f37025eb8737b3a3338255b7d328ebddea20a"
          }
        }
      ]
    },
    "cucumberImpact": {
      "enabled": true,
      "adapter": "android-jvm-feature-gate"
    },
    "maintainability": {
      "enabled": false,
      "adapter": "android-compose"
    }
  },
  "classification": {
    "rules": [
      {
        "id": "human_only",
        "category": "human_only",
        "match": {
          "prefixes": [
            ".github/workflows/"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "delivery_tooling",
        "category": "delivery_tooling",
        "match": {
          "prefixes": [
            "tools/delivery-mcp/",
            ".delivery/",
            ".githooks/",
            ".codex/"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "main_resources",
        "category": "android_resource",
        "match": {
          "prefixes": [
            "app/src/main/res/"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "documentation",
        "category": "non_code_docs_config",
        "match": {
          "exact": [
            "AGENTS.md",
            "CLAUDE.md",
            "README.md",
            "LICENSE",
            ".gitignore"
          ],
          "prefixes": [
            "docs/",
            ".agents/skills/"
          ],
          "extensions": [
            ".md",
            ".mdx",
            ".txt",
            ".svg",
            ".png",
            ".jpg",
            ".jpeg",
            ".gif",
            ".webp",
            ".ico"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "bdd_features",
        "category": "bdd_feature",
        "match": {
          "patterns": [
            "^app/src/test/resources/features/.*\\.feature$"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": true,
        "productSource": false
      },
      {
        "id": "jvm_tests",
        "category": "jvm_test",
        "match": {
          "patterns": [
            "^app/src/test/.*\\.(?:kt|java)$"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": true,
        "productSource": false
      },
      {
        "id": "instrumented_tests",
        "category": "instrumented_test",
        "match": {
          "prefixes": [
            "app/src/androidTest/"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "data_kotlin",
        "category": "data_kotlin",
        "match": {
          "patterns": [
            "^app/src/main(?:/[^/]*)?/data/.*\\.kt$",
            "^app/src/main/.*/data/.*\\.kt$"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "di_kotlin",
        "category": "di_kotlin",
        "match": {
          "patterns": [
            "^app/src/main(?:/[^/]*)?/di/.*\\.kt$",
            "^app/src/main/.*/di/.*\\.kt$"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "ui_kotlin",
        "category": "compose_ui",
        "match": {
          "patterns": [
            "^app/src/main(?:/[^/]*)?/ui/.*\\.kt$",
            "^app/src/main/.*/ui/.*\\.kt$"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "android_manifests",
        "category": "android_manifest",
        "match": {
          "exact": [
            "app/src/main/AndroidManifest.xml"
          ],
          "patterns": [
            "^app/src/[^/]+/AndroidManifest\\.xml$"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "build_infrastructure",
        "category": "build_infrastructure",
        "match": {
          "exact": [
            "build.gradle.kts",
            "app/build.gradle.kts",
            "settings.gradle.kts",
            "gradle.properties",
            "gradlew",
            "gradlew.bat",
            "Makefile"
          ],
          "prefixes": [
            "gradle/",
            "scripts/"
          ]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "domain_kotlin",
        "category": "isolated_domain_kotlin",
        "match": {
          "patterns": [
            "^app/src/main/.*/domain/.*\\.kt$",
            "^app/src/main/domain/.*\\.kt$"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": true
      },
      {
        "id": "production_kotlin",
        "category": "production_kotlin",
        "match": {
          "patterns": [
            "^app/src/main/.*\\.(?:kt|java)$"
          ]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": true
      }
    ],
    "fallback": {
      "category": "unknown_functional",
      "isGateCTrigger": true,
      "isGate0Trigger": false,
      "productSource": "auto"
    }
  },
  "checkCatalog": {
    "feature_jvm_dev": {
      "kind": "builtin",
      "label": "Isolated feature and affected Dev JVM tests",
      "handler": "feature_jvm_dev",
      "display": "Dev JVM feature runner and affected classes: {testClasses}",
      "requires": [
        "featureFile",
        "runnerClass",
        "testClasses"
      ]
    },
    "delivery_unit": {
      "kind": "command",
      "label": "Delivery tooling tests",
      "command": "npm",
      "args": [
        "--prefix",
        "tools/delivery-mcp",
        "test"
      ],
      "display": "npm --prefix tools/delivery-mcp test",
      "timeoutMs": 300000
    },
    "jvm_test_dev": {
      "kind": "command",
      "label": "Dev JVM tests",
      "command": "make",
      "args": [
        "test",
        "FLAVOR=Dev"
      ],
      "display": "make test FLAVOR=Dev",
      "timeoutMs": 900000
    },
    "lint_dev": {
      "kind": "command",
      "label": "Dev Android lint",
      "command": "make",
      "args": [
        "lint",
        "FLAVOR=Dev"
      ],
      "display": "make lint FLAVOR=Dev",
      "timeoutMs": 900000
    },
    "build_dev": {
      "kind": "command",
      "label": "Dev Android build",
      "command": "make",
      "args": [
        "build",
        "FLAVOR=Dev"
      ],
      "display": "make build FLAVOR=Dev",
      "timeoutMs": 900000
    },
    "e2e_dev": {
      "kind": "command",
      "label": "Dev instrumented tests",
      "command": "make",
      "args": [
        "e2e",
        "FLAVOR=Dev"
      ],
      "display": "make e2e FLAVOR=Dev",
      "timeoutMs": 1800000
    },
    "jvm_test_staging": {
      "kind": "command",
      "label": "Staging JVM tests",
      "command": "make",
      "args": [
        "test",
        "FLAVOR=Staging"
      ],
      "display": "make test FLAVOR=Staging",
      "timeoutMs": 900000
    },
    "lint_staging": {
      "kind": "command",
      "label": "Staging Android lint",
      "command": "make",
      "args": [
        "lint",
        "FLAVOR=Staging"
      ],
      "display": "make lint FLAVOR=Staging",
      "timeoutMs": 900000
    },
    "build_staging": {
      "kind": "command",
      "label": "Staging Android build",
      "command": "make",
      "args": [
        "build",
        "FLAVOR=Staging"
      ],
      "display": "make build FLAVOR=Staging",
      "timeoutMs": 900000
    },
    "e2e_staging": {
      "kind": "command",
      "label": "Staging instrumented tests",
      "command": "make",
      "args": [
        "e2e",
        "FLAVOR=Staging"
      ],
      "display": "make e2e FLAVOR=Staging",
      "timeoutMs": 1800000
    },
    "no_wip_in_scope": {
      "kind": "builtin",
      "label": "No @wip tags in completed scope",
      "handler": "no_wip_in_scope",
      "display": "verify no @wip tags in completed feature scope",
      "requires": [
        "scopeFeatures"
      ]
    },
    "android_device": {
      "kind": "builtin",
      "label": "Android device prerequisite",
      "handler": "android_device",
      "display": "verify an authorized Android device is connected"
    },
    "feature_device_dev": {
      "kind": "builtin",
      "label": "Reviewed feature Dev device tests",
      "handler": "feature_device_dev",
      "display": "Dev device test classes: {deviceTestClasses}",
      "requires": [
        "deviceTestClasses"
      ]
    }
  },
  "gates": {
    "0": {
      "id": "0",
      "description": "Complete Dev JVM tests for BDD feature and glue compatibility",
      "priority": 1,
      "checkIds": [
        "jvm_test_dev"
      ],
      "postPushChecks": []
    },
    "NONE": {
      "id": "NONE",
      "description": "No local verification is required for documentation-only or empty changes",
      "priority": 0,
      "checkIds": [],
      "postPushChecks": []
    },
    "A": {
      "id": "A",
      "description": "Isolated Kotlin or delivery tooling verification",
      "priority": 2,
      "checkIds": [
        "jvm_test_dev"
      ],
      "postPushChecks": []
    },
    "B": {
      "id": "B",
      "description": "Isolated JVM feature closure when proven by both Git trees; otherwise complete Dev JVM tests",
      "priority": 3,
      "checkIds": [
        "jvm_test_dev"
      ],
      "postPushChecks": []
    },
    "C": {
      "id": "C",
      "description": "Shared Android architecture, UI, resources, build, and instrumented verification, including individual high-risk scenario closure",
      "priority": 4,
      "checkIds": [
        "android_device",
        "lint_dev",
        "jvm_test_dev",
        "build_dev",
        "e2e_dev"
      ],
      "postPushChecks": []
    },
    "D": {
      "id": "D",
      "description": "Batch or User Story closure with complete Dev regression",
      "priority": 5,
      "checkIds": [
        "no_wip_in_scope",
        "android_device",
        "lint_dev",
        "jvm_test_dev",
        "build_dev",
        "e2e_dev"
      ],
      "postPushChecks": [
        "ci_green"
      ]
    },
    "R": {
      "id": "R",
      "description": "CI repair path with complete Staging verification",
      "priority": 6,
      "checkIds": [
        "android_device",
        "delivery_unit",
        "lint_staging",
        "jvm_test_staging",
        "build_staging",
        "e2e_staging"
      ],
      "postPushChecks": [
        "ci_green"
      ]
    }
  }
}
