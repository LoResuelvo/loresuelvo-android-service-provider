<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Camera capture for the chat media attach flow (US-B). The
      system camera app writes the captured photo to a
      `FileProvider`-backed URI in the app's cache directory;
      the manifest declares the provider with the
      `${applicationId}.fileprovider` authority and the
      `file_paths.xml` resource grants access to `cacheDir/camera/`.
      No runtime CAMERA permission is required because the
      provider app does not read the camera sensor directly — it
      delegates to the system camera via `TakePicture`.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      Audio capture for the chat media attach flow (US-C). The
      provider app does read the microphone directly via
      `MediaRecorder`, so the runtime permission is required —
      the chat route requests it via
      `ActivityResultContracts.RequestPermission` before starting
      a recording.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".LoresuelvoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Loresuelvoandroidserviceprovider">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Loresuelvoandroidserviceprovider">

            <!-- Lanzador de la aplicación -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Callback de Auth0 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${auth0Scheme}"
                    android:host="${auth0Domain}"
                    android:pathPrefix="/android/${applicationId}/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
