# Copy this file to `local.properties` (which is gitignored) and fill in your values.
#
# Dev flavor
AUTH0_DOMAIN=loresuelvo-dev.auth0.com
AUTH0_CLIENT_ID=
AUTH0_SCHEME=com.loresuelvo.provider
AUTH0_AUDIENCE=http://localhost:8080
API_URL=http://10.0.2.2:8080
#
# Staging flavor (CI reads from secrets; this is for local staging builds)
AUTH0_DOMAIN_STAGING=
AUTH0_CLIENT_ID_STAGING=
AUTH0_SCHEME_STAGING=com.loresuelvo.provider.staging
AUTH0_AUDIENCE_STAGING=
API_URL_STAGING=
#
# Production flavor
AUTH0_DOMAIN_PROD=
AUTH0_CLIENT_ID_PROD=
AUTH0_SCHEME_PROD=com.loresuelvo.provider.prod
AUTH0_AUDIENCE_PROD=
API_URL_PROD=
